{
  "expo": {
    "name": "Shopora",
    "slug": "shopora",
    "scheme": "shopora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b6b63"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "website.shopora.app"
    },
    "android": {
      "package": "website.shopora.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b6b63",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 2
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Shopora uses your photos so you can add product pictures.",
          "cameraPermission": "Shopora uses the camera so you can take product pictures."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "apiUrl": "https://www.shopora.website",
      "eas": {
        "projectId": "2bfc96ad-2189-4eed-8ab2-cf773801ac1f"
      }
    },
    "owner": "chloetrini",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2bfc96ad-2189-4eed-8ab2-cf773801ac1f",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000
    },
    "platforms": [
      "ios",
      "android"
    ]
  }
}
