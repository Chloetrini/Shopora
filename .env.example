# Neon connection string (Neon console -> Connect). Pooled URL is fine.
DATABASE_URL=
# Public origin, no trailing slash. Used for links in emails and canonical URLs.
APP_URL=http://localhost:3000
# 32+ random characters: openssl rand -base64 32
SESSION_SECRET=
# Mailgun (order confirmation emails). Without these, emails are printed to the terminal in dev.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=Shopora <orders@your-domain.com>
# Set MAILGUN_BASE_URL=https://api.eu.mailgun.net for EU-region domains.
MAILGUN_BASE_URL=https://api.mailgun.net
# Google sign-in (Google Cloud Console -> Credentials -> OAuth client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
